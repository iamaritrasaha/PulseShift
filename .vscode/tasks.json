{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build REVIX LINK",
      "type": "process",
      "command": "${env:HOME}/.platformio/penv/bin/pio",
      "args": ["run", "-e", "esp32dev_wokwi"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "REVIX: Record bench CAN log",
      "type": "process",
      "command": "${env:HOME}/.platformio/penv/bin/pio",
      "args": ["device", "monitor", "--project-dir", "${workspaceFolder}",
        "--environment", "esp32dev_bike", "--baud", "115200", "--filter", "log2file",
        "--dtr", "0", "--rts", "0", "--no-reconnect"],
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "problemMatcher": []
    }
  ]
}
